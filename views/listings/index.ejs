<% layout("/layouts/boilerplate") %>

<style>
  #filters-container {
    display: flex;
    overflow-x: auto;
    white-space: nowrap;
    padding: 10px;
    border-radius: 10px;
    gap: 15px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #filters-container::-webkit-scrollbar {
    display: none;
  }

  .filter {
    text-align: center;
    padding: 10px 15px;
    border-radius: 10px;
    transition: all 0.3s ease;
    font-size: 14px;
    color: #333;
    background-color: #f8f9fa;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 80px;
  }

  .filter:hover, .filter.active {
    background-color: #e2e6ea;
    cursor: pointer;
    transform: scale(1.1);
  }

  .filter i {
    font-size: 22px;
    margin-bottom: 5px;
  }

  .filter a {
    text-decoration: none;
    color: inherit;
  }

  .filters-wrapper {
    overflow-x: auto;
    display: flex;
    justify-content: center;
    padding: 10px;
  }

  @media (max-width: 767.98px) {
    #filters-container {
      padding: 5px;
      gap: 10px;
    }

    .filter {
      font-size: 12px;
      padding: 6px 10px;
    }
  }

  .listing-card {
    border: none;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .listing-card:hover {
    transform: scale(1.05);
    box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.15);
  }

  .listing-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
  }

  .listing-card .card-body {
    padding: 15px;
  }

  .listing-card .card-text {
    font-size: 16px;
    color: #333;
    margin-left: 10px;
  }

</style>

<body>
  <div class="filters-wrapper">
    <div id="filters-container">
      <div class="filter">
        <a href="/listings?filter=all">
          <i class="fa-solid fa-house"></i>
          <p>All</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=trending">
          <i class="fa-solid fa-fire"></i>
          <p>Trending</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=rooms">
          <i class="fa-solid fa-bed"></i>
          <p>Rooms</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=temple">
          <i class="fa-solid fa-gopuram"></i>
          <p>Temple</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=cities">
          <i class="fa-solid fa-city"></i>
          <p>Cities</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=mountains">
          <i class="fa-solid fa-mountain"></i>
          <p>Mountains</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=castles">
          <i class="fa-solid fa-fort-awesome"></i>
          <p>Castles</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=camping">
          <i class="fa-solid fa-campground"></i>
          <p>Camping</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=arctic">
          <i class="fa-solid fa-snowflake"></i>
          <p>Arctic</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=farms">
          <i class="fa-solid fa-cow"></i>
          <p>Farms</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=domes">
          <i class="fa-solid fa-igloo"></i>
          <p>Domes</p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings?filter=boats">
          <i class="fa-solid fa-ship"></i>
          <p>Boats</p>
        </a>
      </div>
    </div>
  </div>

  <div class="row mt-2">
    <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 mx-auto my-0">
      <% if (allListing.length === 0) { %>
      <div class="alert alert-info mx-auto my-0">
        No listings found for this filter.
      </div>
      <% } %> 
      <% for(let listing of allListing){ %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" />
          <div class="card-body">
            <p class="card-text">
              <b><i>@<%=listing.owner.username %></i> <br />
                <%= listing.title %>
              </b>
            </p>
          </div>
        </div>
      </a>
      <% } %>
    </div>
  </div>
</body>
